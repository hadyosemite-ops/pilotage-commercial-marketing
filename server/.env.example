PORT=4000
JWT_SECRET=change-moi-en-une-chaine-longue-et-aleatoire

# Chaine de connexion Postgres Supabase.
# Supabase > ton projet > Connect (bouton en haut) > "Transaction pooler" (port 6543)
# recommande pour les environnements serverless comme Vercel.
# Exemple : postgres://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.xxxx:MOT_DE_PASSE@xxxx.pooler.supabase.com:6543/postgres

# Identification email + mot de passe (restauree le 2026-07-25). Utilisees uniquement
# par `npm run seed` pour creer le premier compte admin.
SEED_ADMIN_EMAIL=admin@monentreprise.com
SEED_ADMIN_PASSWORD=ChangeMoi123!

# Cle d'acces dediee a EMC APEX (app desktop) : meme valeur cote serveur et cote EMC
# APEX (Reglages > CRM). Permet a EMC APEX de lire/ecrire sans passer par le login web.
EMC_APEX_API_KEY=

# Optionnel : pour reactiver "Se connecter avec Google" en plus du mot de passe,
# decommente et renseigne (route /api/auth/google, toujours presente) :
# GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
# ALLOWED_EMAILS=admin@gmail.com,collegue1@gmail.com,collegue2@gmail.com

# Envoi d'email (mot de passe oublie) via Gmail SMTP, avec ton propre compte Gmail :
# 1) Active la validation en 2 etapes sur ce compte Google (si pas deja fait) :
#    myaccount.google.com/security
# 2) Genere un "mot de passe d'application" : myaccount.google.com/apppasswords
#    (choisis "Mail" puis "Autre (nom personnalise)", copie le mot de passe de 16
#    caracteres genere : ce n'est PAS le mot de passe habituel du compte).
SMTP_USER=hadyosemite@gmail.com
SMTP_APP_PASSWORD=

# URL publique de l'app (sans slash final), utilisee pour construire le lien de
# reinitialisation de mot de passe envoye par email. En prod : ton domaine Vercel,
# ex. https://pilotage-commercial-marketing.vercel.app
APP_URL=http://localhost:5173
